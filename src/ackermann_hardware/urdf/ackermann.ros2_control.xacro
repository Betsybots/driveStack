<?xml version="1.0"?>
<!--
  ros2_control block for the Ackermann base. Include it from the robot's URDF and call
    <xacro:ackermann_ros2_control name="AckermannBase" use_mock_hardware="false"/>
  Joint names must match the robot description and the bicycle_steering_controller config.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ackermann_ros2_control"
               params="name
                       use_mock_hardware:=false
                       traction_joint:=rear_wheel_joint
                       steering_joint:=steering_joint
                       max_steer_angle:=0.6981317">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>ackermann_hardware/AckermannSystem</plugin>
        <param name="use_mock_hardware">${use_mock_hardware}</param>

        <!-- Kraken X60 (TalonFX) on the solid rear axle -->
        <param name="canbus_name">can0</param>
        <param name="drive_motor_id">0</param>
        <!-- wheel turns per motor turn; 0.5 = 2:1 reduction -->
        <param name="gear_ratio">0.5</param>
        <!-- wheel rad/s; 15 rad/s is about 1 m/s on the 0.0667 m wheel -->
        <param name="max_wheel_velocity">15.0</param>
        <param name="stator_current_limit">40.0</param>
        <param name="supply_current_limit">20.0</param>
        <param name="neutral_mode">coast</param>
        <param name="drive_motor_inverted">true</param>
        <!-- Slot 0 velocity gains, in volts per rotor rps. Tune kS and kP on the robot. -->
        <param name="velocity_k_v">0.12</param>
        <param name="velocity_k_p">0.1</param>
        <param name="velocity_k_i">0.0</param>
        <param name="velocity_k_d">0.0</param>
        <param name="velocity_k_s">0.0</param>
        <param name="velocity_k_a">0.0</param>
        <!-- rotor turns/s^2; 0 = no acceleration limit on the motor -->
        <param name="velocity_acceleration">0.0</param>

        <!--
          AGFRC A73BHLW servo on GPIO18 (physical pin 12) = pwmchip0/pwm0.
          Needs "dtoverlay=pwm" in /boot/firmware/config.txt and a reboot;
          check with: ls /sys/class/pwm/pwmchip0
        -->
        <param name="pwm_chip">0</param>
        <param name="pwm_channel">0</param>
        <param name="pwm_period_ns">20000000</param>
        <param name="servo_min_pulse_ns">1000000</param>
        <param name="servo_center_pulse_ns">1500000</param>
        <param name="servo_max_pulse_ns">2000000</param>
        <!-- Positive steering angle must turn the robot left (REP-103); flip this if it doesn't. -->
        <param name="steering_inverted">false</param>
        <param name="max_steer_angle">${max_steer_angle}</param>
        <param name="steering_slew_rate">6.0</param>
      </hardware>

      <joint name="${traction_joint}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${steering_joint}">
        <command_interface name="position">
          <param name="min">-${max_steer_angle}</param>
          <param name="max">${max_steer_angle}</param>
        </command_interface>
        <state_interface name="position"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
